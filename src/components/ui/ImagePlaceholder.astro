---
// Stand-in for a photo that hasn't been supplied yet. Swap for an astro:assets <Image> later.
interface Props {
  /** CSS aspect-ratio, e.g. "4/3" or "16/9". */
  ratio?: string;
  chamfer?: "none" | "tr" | "lg";
  label?: string;
  class?: string;
}
const { ratio = "4/3", chamfer = "none", label = "Imagine în curând", class: cls } = Astro.props;
const cut = { none: "", tr: "chamfer-tr", lg: "chamfer-lg" }[chamfer];
---
<div
  aria-hidden="true"
  class:list={["flex items-center justify-center bg-surface-alt", cut, cls]}
  style={`aspect-ratio:${ratio}`}
>
  <span class="text-eyebrow uppercase text-ink">{label}</span>
</div>
