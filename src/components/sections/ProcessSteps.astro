---
// "Cum lucrăm" on the homepage: the four steps as a timeline. A vertical list below md, a 2x2
// grid from md, one row joined by a line from lg. Each step has a cut-corner marker with its icon.
// When the section scrolls into view, the gold line fills from step 1 to step 4 and each marker
// turns gold as the line reaches it; it resets once the section leaves the viewport and plays
// again on the next visit. Without JS or with reduced motion it shows filled.
import SectionHeading from "../ui/SectionHeading.astro";
import IconConsultanta from "../icons/IconConsultanta.astro";
import IconInstalare from "../icons/IconInstalare.astro";
import IconService from "../icons/IconService.astro";

const steps = [
  { title: "Consultanță", text: "Discutăm nevoile dumneavoastră și evaluăm riscurile la fața locului.", Icon: IconConsultanta },
  { title: "Instalare", text: "Montăm, configurăm și testăm sistemul, apoi vă arătăm cum îl folosiți.", Icon: IconInstalare },
  { title: "Mentenanță", text: "Verificăm periodic sistemul și intervenim rapid când este nevoie.", Icon: IconService },
];
const last = steps.length - 1;
---
<div class="flex flex-col gap-8 md:gap-12 lg:gap-14">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <SectionHeading eyebrow="Cum lucrăm">De la evaluare la mentenanță.</SectionHeading>
    <p class="m-0 max-w-[26rem] text-ink-muted">
      Aceeași echipă vă însoțește la fiecare pas, de la prima vizită până la service.
    </p>
  </div>

  <div data-steps class="relative">
    <!-- lg: one track through the marker centres, with its gold fill on top. -->
    <span class="absolute top-7 right-0 left-7 hidden h-px bg-line lg:block" aria-hidden="true"></span>
    <span data-fill class="fill-x track absolute top-[27px] right-0 left-7 hidden h-0.5 bg-accent lg:block" aria-hidden="true"></span>

    <ol class="relative m-0 grid list-none gap-8 p-0 md:grid-cols-2 md:gap-x-8 md:gap-y-10 lg:grid-cols-3">
      {steps.map(({ title, text, Icon }, i) => (
        <li class="relative flex gap-5 md:flex-col md:pt-6 lg:gap-6 lg:pt-0" style={`--i:${i}`}>
          {/* md: a hairline opens each step. */}
          <span class="absolute top-0 left-0 hidden h-px w-full bg-line md:block lg:hidden" aria-hidden="true"></span>
          <span data-fill class="fill-x hairline absolute top-0 left-0 hidden h-px w-full bg-accent md:block lg:hidden" aria-hidden="true"></span>
          {/* Below md: a connector runs down to the next marker. */}
          {i < last && (
            <>
              <span class="absolute top-12 -bottom-8 left-6 w-px bg-line md:hidden" aria-hidden="true"></span>
              <span data-fill class="fill-y absolute top-12 -bottom-8 left-6 w-px bg-accent md:hidden" aria-hidden="true"></span>
            </>
          )}
          <span data-marker class="relative z-10 flex size-12 shrink-0 items-center justify-center border bg-surface chamfer-sm md:size-14" aria-hidden="true">
            <Icon class="size-7 text-accent md:size-8" />
          </span>
          <div class="flex flex-col gap-1.5 pt-1 md:gap-2 md:pt-0 lg:pr-4">
            <span class="text-eyebrow text-accent-ink">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="m-0 text-title uppercase">{title}</h3>
            <p class="m-0 text-small text-ink-muted">{text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
  /* Filled is the default, so the section never stays grey without JS or with reduced motion. */
  .fill-x { transform-origin: left; }
  .fill-y { transform-origin: top; }
  [data-marker] { border-color: var(--accent); }

  /* Armed by the script until the section is in view. */
  [data-armed] .fill-x { transform: scaleX(0); }
  [data-armed] .fill-y { transform: scaleY(0); }
  [data-armed] [data-marker] { border-color: var(--line); }

  /* Each step starts 350ms after the previous one; the lg track crosses all three in 1050ms. */
  [data-armed][data-revealed] [data-fill] { transform: none; }
  [data-armed][data-revealed] [data-marker] {
    border-color: var(--accent);
    transition: border-color 300ms ease calc(var(--i) * 350ms);
  }
  [data-armed][data-revealed] .track { transition: transform 1050ms linear; }
  [data-armed][data-revealed] .hairline { transition: transform 500ms ease-out calc(var(--i) * 350ms); }
  [data-armed][data-revealed] .fill-y { transition: transform 350ms linear calc(var(--i) * 350ms + 150ms); }
</style>

<script>
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const root of document.querySelectorAll<HTMLElement>("[data-steps]")) {
      root.setAttribute("data-armed", "");
      // Fill once 40% is on screen; reset (instantly, the transitions only run while revealed)
      // when it has left the viewport entirely, so it plays again on the next visit.
      new IntersectionObserver(
        ([entry]) => {
          if (entry.intersectionRatio >= 0.4) root.setAttribute("data-revealed", "");
          else if (!entry.isIntersecting) root.removeAttribute("data-revealed");
        },
        { threshold: [0, 0.4] },
      ).observe(root);
    }
  }
</script>
