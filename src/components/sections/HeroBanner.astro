---
// Full-width hero: eyebrow, headline with the gold rule, body, a primary CTA and a secondary link
// button, over a slideshow of background photos. Every part is optional. With several images they
// cross-fade on a timer (paused while a mouse is over the hero, off with reduced motion); with none
// the hero sits on the page background and uses the theme colours.
//
// Over photos the hero always uses the dark palette (brand-* colours, fixed in both themes) under a
// flat onyx tint, since the photos are low-key and stay dark in the light theme too.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";

interface Action { label: string; href: string }
/** A photo, or a photo with its CSS object-position (centred by default). */
type Slide = ImageMetadata | { src: ImageMetadata; position: string };
interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string;
  cta?: Action;
  link?: Action;
  /** Background photos, shown in order. None: plain page background. */
  images?: Slide[];
  /** Time each photo stays up, in ms. */
  interval?: number;
  /** Opacity of the onyx tint over the photos, 0–1. */
  tint?: number;
}
const { eyebrow, headline, body, cta, link, images = [], interval = 6000, tint = 0.55 } = Astro.props;
const slides = images.map((s) => ("position" in s ? s : { src: s, position: undefined }));
const hasImages = slides.length > 0;
const hasText = Boolean(eyebrow || headline || body);
const hasActions = Boolean(cta || link);
---
<section data-hero data-interval={interval}
  class:list={[
    "relative flex min-h-[600px] overflow-hidden md:min-h-[640px]",
    hasImages ? "bg-brand-onyx text-brand-white" : "bg-surface text-ink",
  ]}>
  {hasImages && (
    <div aria-hidden="true">
      {slides.map(({ src, position }, i) => (
        <Image src={src} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "low"}
          data-slide data-active={i === 0 ? "" : undefined}
          class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-900 ease-in-out data-active:opacity-100"
          style={position && `object-position: ${position}`} />
      ))}
      <div class="absolute inset-0" style={`background: rgb(15 15 15 / ${tint})`}></div>
    </div>
  )}

  <div class="relative mx-auto flex w-full max-w-7xl flex-col justify-center px-4 py-12 md:px-12 md:py-24">
    <div class="flex max-w-[40rem] flex-col gap-8 max-md:self-stretch">
      {hasText && (
        <div class="flex flex-col items-start gap-3">
          {eyebrow && (
            <span class:list={["text-eyebrow uppercase", hasImages ? "text-brand-gold" : "text-accent-ink"]}>{eyebrow}</span>
          )}
          {headline && (
            <>
              <h1 class="m-0 text-headline uppercase text-balance md:text-display">{headline}</h1>
              <span class="rule-gold" aria-hidden="true" />
            </>
          )}
          {body && (
            <p class:list={["m-0 mt-2 max-w-[38rem] text-body-lg", hasImages ? "text-brand-mist" : "text-ink-muted"]}>{body}</p>
          )}
        </div>
      )}
      {hasActions && (
        <div class="flex flex-col gap-4 md:flex-row md:flex-wrap">
          {cta && <Button href={cta.href} size="lg" class="w-full md:w-auto">{cta.label}</Button>}
          {link && (
            <Button href={link.href} variant="secondary" size="lg"
              class:list={["w-full md:w-auto", hasImages && "border-brand-silver! bg-brand-onyx/40 text-brand-white! hover:border-brand-gold!"]}>
              {link.label}
            </Button>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<script>
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const hero of document.querySelectorAll<HTMLElement>("[data-hero]")) {
      const slides = [...hero.querySelectorAll<HTMLElement>("[data-slide]")];
      if (slides.length < 2) continue;
      let active = 0;
      let paused = false;
      setInterval(() => {
        if (paused || document.hidden) return;
        slides[active].removeAttribute("data-active");
        active = (active + 1) % slides.length;
        slides[active].setAttribute("data-active", "");
      }, Number(hero.dataset.interval));
      hero.addEventListener("pointerenter", (e) => { paused = e.pointerType === "mouse"; });
      hero.addEventListener("pointerleave", () => { paused = false; });
    }
  }
</script>
