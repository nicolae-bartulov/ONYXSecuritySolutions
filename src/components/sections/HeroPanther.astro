---
// Hero photo: a black cat with gold eyes on black, filling a chamfered 4:3 frame.
import { Image } from "astro:assets";
import cat from "../../assets/img/blackCat.jpg";

interface Props { class?: string }
const { class: cls } = Astro.props;
---
<div class:list={["chamfer-lg aspect-[4/3] overflow-hidden bg-surface", cls]} aria-hidden="true">
  <Image src={cat} alt="" widths={[640, 960, 1280]} sizes="(min-width: 768px) 50vw, 100vw" loading="eager"
    class="size-full object-cover" />
</div>
