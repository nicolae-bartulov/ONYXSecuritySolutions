---
// The whole panther, fitted inside a chamfered frame: stand-in for the hero photograph
// described in design doc §6 until one is supplied.
import { Image } from "astro:assets";
import panther from "../../assets/brand/logos/onyx-icon-on-dark.png";

interface Props { class?: string }
const { class: cls } = Astro.props;
---
<div class:list={["chamfer-lg flex aspect-[4/3] items-center justify-center bg-surface p-6 md:p-10", cls]} aria-hidden="true">
  <Image src={panther} alt="" widths={[640, 1058]} sizes="(min-width: 768px) 50vw, 100vw" loading="eager"
    class="size-full object-contain" />
</div>
