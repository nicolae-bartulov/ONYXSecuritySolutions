---
// Homepage services: image on the left, the eight services on the right. Hovering or focusing a
// service shows its image; when nobody interacts, it moves to the next one every `interval` ms.
// Each row links to its section on /solutii, so the list works without JS too.
// Below lg the list gives way to one service at a time under the image, with previous/next arrows
// and a progress ring next to the title.
import { Image } from "astro:assets";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import { services } from "../../data/services";
import { cta } from "../../data/site";
import { url } from "../../lib/url";

interface Props {
  /** Time each service stays selected while autoplaying, in ms. */
  interval?: number;
}
const { interval = 5000 } = Astro.props;

const total = String(services.length).padStart(2, "0");
const arrow = "inline-flex size-12 cursor-pointer items-center justify-center rounded-sm border border-line-strong text-ink transition-colors duration-150 hover:border-accent hover:text-accent-ink";
---
<div class="flex flex-col gap-8 md:gap-14">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <SectionHeading eyebrow="Servicii">Șapte servicii. Un singur partener.</SectionHeading>
    <Button href={cta.secondary.href} variant="secondary">{cta.secondary.label}</Button>
  </div>

  <div data-services-showcase data-playing style={`--svc-interval:${interval}ms`}
    class="grid gap-6 md:gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-12">
    <div class="chamfer-lg relative aspect-[4/3] bg-surface-alt md:aspect-video lg:aspect-auto" aria-hidden="true">
      {services.map(({ image, imagePosition }, i) => (
        <div data-pane data-active={i === 0 ? "" : undefined}
          class="absolute inset-0 flex items-center justify-center p-6 opacity-0 transition-opacity duration-300 data-active:opacity-100 md:p-8">
          {image ? (
            <Image src={image} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 58vw, 100vw"
              class="absolute inset-0 size-full object-cover" style={imagePosition && `object-position: ${imagePosition}`} />
          ) : (
            <span class="text-center text-eyebrow uppercase text-ink">Fotografie în curând</span>
          )}
        </div>
      ))}
    </div>

    <!-- lg and up: the full list -->
    <ul data-list class="m-0 hidden list-none flex-col p-0 lg:flex">
      {services.map(({ slug, name, line, Icon }, i) => (
        <li>
          <a href={url(`/solutii#${slug}`)} data-item data-active={i === 0 ? "" : undefined}
            class="group relative flex min-h-21 items-center gap-5 border-b border-line py-4 pr-1 text-ink no-underline">
            <span class="w-6 shrink-0 text-eyebrow text-ink-muted group-data-active:text-accent-ink">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="h-0.5 w-0 shrink-0 bg-accent transition-[width] duration-150 group-data-active:w-10" aria-hidden="true" />
            <span class="flex min-w-0 flex-1 flex-col gap-1">
              <span class="text-title uppercase text-ink-muted transition-colors duration-150 group-hover:text-ink group-data-active:text-ink">{name}</span>
              <span class="text-small text-ink-muted">{line}</span>
            </span>
            <Icon class="mr-6 size-12 shrink-0 text-ink-muted group-data-active:text-accent light:group-data-active:text-ink" />
            <span data-progress class="absolute -bottom-px left-0 h-0.5 w-full origin-left scale-x-0 bg-accent" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>

    <!-- Below lg: one service at a time -->
    <div class="flex flex-col gap-4 lg:hidden">
      {services.map(({ slug, name, line, Icon }, i) => (
        <div data-slide data-active={i === 0 ? "" : undefined} class="hidden flex-col gap-3 data-active:flex">
          <div class="flex items-center gap-4">
            <span class="rule-gold" aria-hidden="true" />
            <span class="text-eyebrow text-accent-ink">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <div class="flex items-center justify-between gap-4">
            <div class="flex min-w-0 flex-col gap-3">
              <h3 class="m-0 text-title uppercase">{name}</h3>
              <p class="m-0 text-body text-ink md:text-body-lg">{line}</p>
            </div>
            <span class="relative grid size-16 shrink-0 place-items-center" aria-hidden="true">
              <svg class="absolute inset-0 size-full -rotate-90" viewBox="0 0 64 64" fill="none">
                <circle cx="32" cy="32" r="31" stroke-width="2" class="stroke-line" />
                <circle data-ring cx="32" cy="32" r="31" stroke-width="2" class="stroke-accent motion-reduce:hidden" />
              </svg>
              <Icon class="size-8 text-accent light:text-ink" />
            </span>
          </div>
          <a href={url(`/solutii#${slug}`)} class="inline-flex min-h-11 items-center gap-2 self-start text-button uppercase text-accent-ink no-underline transition-colors duration-150 hover:text-ink">
            Detalii
            <svg class="size-4" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M6 16h20M19 9l7 7-7 7" /></svg>
          </a>
        </div>
      ))}
      <div class="flex items-center justify-between gap-4 border-t border-line pt-4">
        <span class="text-eyebrow text-ink-muted"><span data-counter>01</span> / {total}</span>
        <div class="flex gap-3">
          <button type="button" data-step="-1" class={arrow} aria-label="Serviciul anterior">
            <svg class="size-5" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M26 16H6M13 9l-7 7 7 7" /></svg>
          </button>
          <button type="button" data-step="1" class={arrow} aria-label="Serviciul următor">
            <svg class="size-5" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M6 16h20M19 9l7 7-7 7" /></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* The progress bar (lg) and ring (below lg) double as the autoplay clock: their animationend
     selects the next service. Only one of them is displayed, so only one runs at a time.
     global.css turns animations off for prefers-reduced-motion, which also stops autoplay. */
  [data-ring] {
    stroke-dasharray: 194.78; /* 2π × 31 */
    stroke-dashoffset: 194.78;
  }
  [data-playing] [data-active] [data-progress] {
    animation: svc-progress var(--svc-interval) linear forwards;
  }
  [data-playing] [data-active] [data-ring] {
    animation: svc-ring var(--svc-interval) linear forwards;
  }
  @keyframes svc-progress {
    to { scale: 1 1; }
  }
  @keyframes svc-ring {
    to { stroke-dashoffset: 0; }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-services-showcase]")) {
    const list = root.querySelector<HTMLElement>("[data-list]")!;
    const items = [...root.querySelectorAll<HTMLElement>("[data-item]")];
    const groups = [items, [...root.querySelectorAll<HTMLElement>("[data-pane]")], [...root.querySelectorAll<HTMLElement>("[data-slide]")]];
    const counter = root.querySelector<HTMLElement>("[data-counter]")!;
    const count = items.length;
    let active = 0;
    let hovered = false;
    let focused = false;
    let visible = true;

    const select = (i: number) => {
      if (i === active) return;
      for (const group of groups) {
        group[active].removeAttribute("data-active");
        group[i].setAttribute("data-active", "");
      }
      active = i;
      counter.textContent = String(i + 1).padStart(2, "0");
    };
    const update = () => root.toggleAttribute("data-playing", !hovered && !focused && visible);

    items.forEach((item, i) => {
      item.addEventListener("pointerenter", () => select(i));
      item.addEventListener("focus", () => select(i));
    });
    for (const clock of root.querySelectorAll("[data-progress], [data-ring]")) {
      clock.addEventListener("animationend", () => select((active + 1) % count));
    }
    for (const button of root.querySelectorAll<HTMLElement>("[data-step]")) {
      button.addEventListener("click", () => select((active + Number(button.dataset.step) + count) % count));
    }

    // Pause while a mouse is over the list (not the image) or keyboard focus is inside. Touch taps
    // and arrow clicks don't count, so autoplay carries on from the newly selected service.
    list.addEventListener("pointerenter", (e) => { hovered = e.pointerType === "mouse"; update(); });
    list.addEventListener("pointerleave", () => { hovered = false; update(); });
    root.addEventListener("focusin", (e) => { focused = (e.target as Element).matches(":focus-visible"); update(); });
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) { focused = false; update(); }
    });
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; update(); }).observe(root);
  }
</script>
