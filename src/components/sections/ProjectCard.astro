---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import ImagePlaceholder from "../ui/ImagePlaceholder.astro";
import { services } from "../../data/services";

interface Props {
  project: CollectionEntry<"proiecte">;
  /** Heading level inside the page outline. */
  as?: "h2" | "h3";
  class?: string;
}
const { project, as: Tag = "h3", class: cls } = Astro.props;
const { title, summary, location, clientType, year, cover, coverAlt } = project.data;
const serviceNames = project.data.services
  .map((slug) => services.find((s) => s.slug === slug)?.name)
  .filter(Boolean)
  .join(" · ");
---
<article class:list={["flex min-w-0 flex-col border border-line bg-surface text-ink", cls]}>
  {cover
    ? <div class="chamfer-tr aspect-[4/3] overflow-hidden bg-surface-alt">
        <Image src={cover} alt={coverAlt ?? ""} widths={[400, 800]} sizes="(min-width: 768px) 33vw, 100vw"
          class="size-full object-cover" />
      </div>
    : <ImagePlaceholder chamfer="tr" />}
  <div class="flex flex-col gap-3 p-6">
    <p class="m-0 text-eyebrow uppercase text-accent-ink">{clientType} · {location} · {year}</p>
    <Tag class="m-0 text-title uppercase text-balance">{title}</Tag>
    <p class="m-0 text-small text-ink-muted">{summary}</p>
    <p class="m-0 text-small text-ink">{serviceNames}</p>
    <span class="rule-gold" aria-hidden="true" />
  </div>
</article>
