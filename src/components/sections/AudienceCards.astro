---
// "Pentru cine" on the homepage: one card per audience with its icon, a short text, the services
// it usually needs (as tags) and a link to /solutii. The whole card is the link; its border turns
// gold on hover. Three columns from lg, wide cards with the icon on the left at md, stacked below.
import SectionHeading from "../ui/SectionHeading.astro";
import IconLocuinte from "../icons/IconLocuinte.astro";
import IconCompanii from "../icons/IconCompanii.astro";
import IconInstitutii from "../icons/IconInstitutii.astro";
import { services } from "../../data/services";
import type { ServiceSlug } from "../../data/service-slugs";
import { url } from "../../lib/url";

const serviceName = (slug: ServiceSlug) => services.find((s) => s.slug === slug)!.name;

const audiences: { title: string; text: string; Icon: typeof IconLocuinte; tags: ServiceSlug[] }[] = [
  {
    title: "Locuințe",
    text: "Case și apartamente protejate discret, cu control de pe telefon.",
    Icon: IconLocuinte,
    tags: ["cctv", "antifractie", "interfonie", "automatizari-porti"],
  },
  {
    title: "Companii",
    text: "Birouri, depozite și spații comerciale, cu acces controlat pentru angajați.",
    Icon: IconCompanii,
    tags: ["control-acces", "cctv", "antifractie", "service-mentenanta"],
  },
  {
    title: "Instituții",
    text: "Școli, clădiri publice și sedii, cu sisteme proiectate conform legislației.",
    Icon: IconInstitutii,
    tags: ["proiectare", "control-acces", "cctv", "consultanta"],
  },
];
---
<SectionHeading eyebrow="Pentru cine">Locuințe, companii și instituții.</SectionHeading>
<div class="mt-8 grid gap-4 md:mt-10 md:gap-6 lg:mt-12 lg:grid-cols-3">
  {audiences.map(({ title, text, Icon, tags }) => (
    <a href={url("/solutii")}
      class="flex flex-col gap-4 border border-line p-6 text-ink no-underline transition-colors duration-150 hover:border-accent md:flex-row md:gap-6 md:px-8 md:py-7 lg:flex-col lg:gap-5 lg:p-8">
      <Icon class="size-8 shrink-0 text-accent md:size-10 light:text-ink" />
      <div class="flex flex-1 flex-col gap-4">
        <div class="flex flex-col gap-2">
          <h3 class="m-0 text-title uppercase">{title}</h3>
          <p class="m-0 text-small text-ink-muted">{text}</p>
        </div>
        <ul class="m-0 flex list-none flex-wrap gap-2 p-0" aria-label="Soluții potrivite">
          {tags.map((slug) => (
            <li class="rounded-sm border border-line px-2 py-1 text-[11px] leading-4 font-medium tracking-[0.14em] uppercase text-ink-muted">
              {serviceName(slug)}
            </li>
          ))}
        </ul>
        <span class="mt-auto inline-flex min-h-11 items-center gap-2 text-button uppercase text-accent-ink">
          Vezi soluțiile
          <svg class="size-4" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M6 16h20M19 9l7 7-7 7" /></svg>
        </span>
      </div>
    </a>
  ))}
</div>
