---
// From the brand moodboard's iconography, redrawn on a 32px grid (1.5px stroke, square caps).
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"svg">;
---
<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true" {...Astro.props}>
  <path d="M10 4h12v24H10z" />
  <circle cx="16" cy="10" r="2.5" />
  <g fill="currentColor" stroke="none">
    <circle cx="14.5" cy="16" r="1" /><circle cx="17.5" cy="16" r="1" />
    <circle cx="14.5" cy="19.5" r="1" /><circle cx="17.5" cy="19.5" r="1" />
    <circle cx="14.5" cy="23" r="1" /><circle cx="17.5" cy="23" r="1" />
  </g>
</svg>
