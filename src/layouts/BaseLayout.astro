---
import "@fontsource-variable/montserrat";
// Preloaded so the fonts download alongside the stylesheet, not after it. Latin-ext carries ș ț ă.
import fontLatin from "@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url";
import fontLatinExt from "@fontsource-variable/montserrat/files/montserrat-latin-ext-wght-normal.woff2?url";
import "../styles/global.css";
import NavBar from "../components/layout/NavBar.astro";
import Footer from "../components/layout/Footer.astro";
import { site } from "../data/site";
import { url } from "../lib/url";

interface Props {
  /** Page name; omitted on the home page. */
  title?: string;
  description?: string;
  /** undefined = dark (default), "light" for forms and long reading pages. */
  theme?: "light";
  /** Absolute or root-relative URL of the 1200x630 link-preview image. */
  image?: string;
  /** schema.org structured data, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}
const { title, description = site.description, theme, image = "/og-default.png", jsonLd } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
// "<" escaped so the data can never close the script tag.
const structuredData = jsonLd && JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---
<html lang="ro" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontLatinExt} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={theme === "light" ? "#ffffff" : "#0f0f0f"} />
    <link rel="icon" href={url("/favicon.ico")} sizes="any" />
    <link rel="icon" href={url("/favicon.png")} type="image/png" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#continut"
      class="sr-only bg-accent px-4 py-3 text-button uppercase text-on-accent focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60]">
      Sari la conținut
    </a>
    <NavBar />
    <main id="continut" class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
