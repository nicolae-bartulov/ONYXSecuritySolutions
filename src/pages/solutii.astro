---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import SolutionsList from "../components/sections/SolutionsList.astro";
---
<BaseLayout title="Soluții"
  description="CCTV, antifracție, interfonie, control acces, automatizări porți, service, consultanță și proiectare pentru sisteme de securitate.">
  <Section class="pb-0 md:pb-0">
    <SectionHeading as="h1" size="display" eyebrow="Soluții"
      lead="De la camere de supraveghere la control acces, proiectăm și instalăm sisteme care lucrează împreună, întreținute de aceeași echipă.">
      Soluții de securitate.
    </SectionHeading>
  </Section>

  <Section>
    <SolutionsList />
  </Section>

  <CtaBand heading="Nu știți ce sistem vă trebuie?"
    lead="Începem cu o discuție și o evaluare la fața locului, apoi vă propunem soluția potrivită." />
</BaseLayout>
