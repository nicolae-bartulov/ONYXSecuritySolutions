---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import HeroPanther from "../components/sections/HeroPanther.astro";
import ServicesShowcase from "../components/sections/ServicesShowcase.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import landscapeLogo from "../assets/brand/logos/onyx-landscape-on-dark.png";
import { cta, site } from "../data/site";
import { url } from "../lib/url";
import { services } from "../data/services";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name,
  legalName: site.legal.companyName,
  description: site.description,
  slogan: site.tagline,
  url: new URL(url("/"), Astro.site).href,
  logo: new URL(landscapeLogo.src, Astro.site).href,
  image: new URL(url("/og-default.png"), Astro.site).href,
  telephone: site.contact.phoneHref.replace("tel:", ""),
  email: site.contact.email,
  address: { "@type": "PostalAddress", streetAddress: site.contact.address, addressCountry: "RO" },
  areaServed: site.contact.serviceArea,
  openingHours: site.contact.openingHours,
  knowsAbout: services.map((s) => s.name),
};
---
<BaseLayout jsonLd={jsonLd}>
  <Section>
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div class="flex flex-col gap-8">
        <SectionHeading as="h1" size="display" eyebrow="Onyx Security Solutions"
          lead="Sisteme de securitate pentru locuințe, companii și instituții. Alese, instalate și întreținute de aceeași echipă.">
          Consult. Design. Secure.
        </SectionHeading>
        <div class="flex flex-wrap gap-4">
          <Button href={cta.primary.href} size="lg">{cta.primary.label}</Button>
          <Button href={cta.secondary.href} variant="secondary" size="lg">{cta.secondary.label}</Button>
        </div>
      </div>
      <HeroPanther />
    </div>
  </Section>

  <Section>
    <ServicesShowcase />
  </Section>

  <Section>
    <ProcessSteps />
  </Section>

  <CtaBand />
</BaseLayout>
