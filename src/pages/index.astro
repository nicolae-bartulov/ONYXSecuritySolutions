---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import ServiceCard from "../components/ui/ServiceCard.astro";
import HeroPanther from "../components/sections/HeroPanther.astro";
import ProjectCard from "../components/sections/ProjectCard.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import landscapeLogo from "../assets/brand/logos/onyx-landscape-on-dark.png";
import { cta, site } from "../data/site";
import { url } from "../lib/url";
import { services } from "../data/services";
import { getProjects } from "../data/projects";

const projects = (await getProjects()).slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name,
  legalName: site.legal.companyName,
  description: site.description,
  slogan: site.tagline,
  url: new URL(url("/"), Astro.site).href,
  logo: new URL(landscapeLogo.src, Astro.site).href,
  image: new URL(url("/og-default.png"), Astro.site).href,
  telephone: site.contact.phoneHref.replace("tel:", ""),
  email: site.contact.email,
  address: { "@type": "PostalAddress", streetAddress: site.contact.address, addressCountry: "RO" },
  areaServed: site.contact.serviceArea,
  openingHours: site.contact.openingHours,
  knowsAbout: services.map((s) => s.name),
};

const steps = [
  { title: "Consultanță", text: "Discutăm nevoile dumneavoastră și evaluăm riscurile la fața locului." },
  { title: "Proiectare", text: "Alegem echipamentele și planificăm fiecare punct al sistemului." },
  { title: "Instalare", text: "Montăm, configurăm și testăm sistemul, apoi vă arătăm cum îl folosiți." },
  { title: "Mentenanță", text: "Verificăm periodic sistemul și intervenim rapid când este nevoie." },
];

const audiences = [
  { title: "Locuințe", text: "Case și apartamente protejate discret, cu control de pe telefon." },
  { title: "Companii", text: "Birouri, depozite și spații comerciale, cu acces controlat pentru angajați." },
  { title: "Instituții", text: "Școli, clădiri publice și sedii, cu sisteme proiectate conform legislației." },
];
---
<BaseLayout jsonLd={jsonLd}>
  <Section>
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div class="flex flex-col gap-8">
        <SectionHeading as="h1" size="display" eyebrow="Onyx Security Solutions"
          lead="Sisteme de securitate pentru locuințe, companii și instituții. Proiectate, instalate și întreținute de aceeași echipă.">
          Consult. Design. Secure.
        </SectionHeading>
        <div class="flex flex-wrap gap-4">
          <Button href={cta.primary.href} size="lg">{cta.primary.label}</Button>
          <Button href={cta.secondary.href} variant="secondary" size="lg">{cta.secondary.label}</Button>
        </div>
      </div>
      <HeroPanther />
    </div>
  </Section>

  <Section>
    <SectionHeading eyebrow="Soluții">Tehnologie pentru siguranță reală.</SectionHeading>
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map(({ slug, name, line, Icon }) => (
        <ServiceCard title={name} description={line} href={url(`/solutii#${slug}`)}>
          <Icon slot="icon" />
        </ServiceCard>
      ))}
    </div>
  </Section>

  <Section>
    <SectionHeading eyebrow="Cum lucrăm">De la evaluare la mentenanță.</SectionHeading>
    <ol class="m-0 mt-8 grid list-none grid-cols-1 gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="flex flex-col gap-3 border-t border-line pt-6">
          <span class="text-eyebrow uppercase text-accent-ink">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="m-0 text-title uppercase">{step.title}</h3>
          <p class="m-0 text-small text-ink-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section class="pt-0 md:pt-0">
    <SectionHeading eyebrow="Pentru cine">Locuințe, companii și instituții.</SectionHeading>
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
      {audiences.map((a) => (
        <div class="flex flex-col gap-3 border border-line p-6">
          <h3 class="m-0 text-title uppercase">{a.title}</h3>
          <p class="m-0 text-small text-ink-muted">{a.text}</p>
        </div>
      ))}
    </div>
  </Section>

  {projects.length > 0 && (
    <Section class="pt-0 md:pt-0">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading eyebrow="Proiecte">Proiecte recente.</SectionHeading>
        <Button href={url("/proiecte")} variant="ghost">Toate proiectele</Button>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </Section>
  )}

  <CtaBand />
</BaseLayout>
