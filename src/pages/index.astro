---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import HeroBanner from "../components/sections/HeroBanner.astro";
import ServicesShowcase from "../components/sections/ServicesShowcase.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import landscapeLogo from "../assets/brand/logos/onyx-landscape-on-dark.png";
import heroGate from "../assets/services/automatizare_porti_homepage_image.png";
import heroCamera from "../assets/services/CCTV.png";
import heroReader from "../assets/services/control_access_homepage_image.png";
import { cta, site } from "../data/site";
import { url } from "../lib/url";
import { services } from "../data/services";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name,
  legalName: site.legal.companyName,
  description: site.description,
  slogan: site.tagline,
  url: new URL(url("/"), Astro.site).href,
  logo: new URL(landscapeLogo.src, Astro.site).href,
  image: new URL(url("/og-default.png"), Astro.site).href,
  telephone: site.contact.phoneHref.replace("tel:", ""),
  email: site.contact.email,
  address: { "@type": "PostalAddress", streetAddress: site.contact.address, addressCountry: "RO" },
  areaServed: site.contact.serviceArea,
  openingHours: site.contact.openingHours,
  knowsAbout: services.map((s) => s.name),
};
---
<BaseLayout jsonLd={jsonLd}>
  <HeroBanner
    eyebrow="Onyx Security Solutions"
    headline="Consult. Design. Secure."
    body="Sisteme de securitate pentru locuințe, companii și instituții. Alese, instalate și întreținute de aceeași echipă."
    cta={cta.primary}
    link={cta.secondary}
    images={[heroGate, { src: heroCamera, position: "50% 10%" }, heroReader]}
  />

  <Section>
    <ServicesShowcase />
  </Section>

  <Section>
    <ProcessSteps />
  </Section>

  <CtaBand />
</BaseLayout>
