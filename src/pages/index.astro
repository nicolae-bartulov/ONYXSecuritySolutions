---
// Temporary home: exercises the layout and components until the real page is built (Phase 3).
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import ServiceCard from "../components/ui/ServiceCard.astro";
import ImagePlaceholder from "../components/ui/ImagePlaceholder.astro";
import TextField from "../components/ui/TextField.astro";
import SelectField from "../components/ui/SelectField.astro";
import CheckboxField from "../components/ui/CheckboxField.astro";
import IconCctv from "../components/icons/IconCctv.astro";
import IconAntifractie from "../components/icons/IconAntifractie.astro";
import IconInterfonie from "../components/icons/IconInterfonie.astro";
import IconControlAcces from "../components/icons/IconControlAcces.astro";
import IconAutomatizari from "../components/icons/IconAutomatizari.astro";
import IconService from "../components/icons/IconService.astro";
import IconConsultanta from "../components/icons/IconConsultanta.astro";
import IconProiectare from "../components/icons/IconProiectare.astro";
import { cta } from "../data/site";

const services = [
  { title: "CCTV", line: "Vizibilitate în orice condiții.", Icon: IconCctv },
  { title: "Antifracție", line: "Protecție care contează.", Icon: IconAntifractie },
  { title: "Interfonie", line: "", Icon: IconInterfonie },
  { title: "Control acces", line: "Acces sigur. Control complet.", Icon: IconControlAcces },
  { title: "Automatizări porți", line: "Confort și siguranță zilnică.", Icon: IconAutomatizari },
  { title: "Service & mentenanță", line: "", Icon: IconService },
  { title: "Consultanță", line: "", Icon: IconConsultanta },
  { title: "Proiectare", line: "", Icon: IconProiectare },
];
---
<BaseLayout>
  <Section>
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div class="flex flex-col gap-8">
        <SectionHeading as="h1" size="display" eyebrow="Onyx Security Solutions"
          lead="Sisteme de securitate pentru locuințe, companii și instituții.">
          Consult. Design. Secure.
        </SectionHeading>
        <div class="flex flex-wrap gap-4">
          <Button href={cta.primary.href} size="lg">{cta.primary.label}</Button>
          <Button href={cta.secondary.href} variant="secondary" size="lg">{cta.secondary.label}</Button>
        </div>
      </div>
      <ImagePlaceholder ratio="4/3" chamfer="lg" />
    </div>
  </Section>

  <Section band>
    <SectionHeading eyebrow="Soluții">Tehnologie pentru siguranță reală.</SectionHeading>
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map(({ title, line, Icon }) => (
        <ServiceCard title={title} description={line || undefined} href="/solutii">
          <Icon slot="icon" />
        </ServiceCard>
      ))}
    </div>
  </Section>

  <div data-theme="light" class="bg-surface text-ink">
    <Section>
      <SectionHeading eyebrow="Previzualizare">Componente formular</SectionHeading>
      <form class="mt-8 grid max-w-2xl gap-6" onsubmit="return false">
        <TextField id="demo-nume" label="Nume" required />
        <TextField id="demo-telefon" label="Telefon" type="tel" error="Introduceți un număr de telefon valid." />
        <SelectField id="demo-serviciu" label="Serviciu dorit" placeholder="Alegeți un serviciu"
          options={services.map((s) => ({ value: s.title, label: s.title }))} />
        <TextField id="demo-mesaj" label="Mesaj" multiline hint="Spuneți-ne ce doriți să protejați." />
        <CheckboxField id="demo-gdpr" required>
          Sunt de acord cu <a href="/politica-de-confidentialitate">politica de confidențialitate</a>.
        </CheckboxField>
        <div class="flex flex-wrap items-center gap-6">
          <Button type="submit">Trimite</Button>
          <Button variant="secondary">Anulează</Button>
          <Button variant="ghost" href="/solutii">Detalii CCTV</Button>
        </div>
      </form>
    </Section>
  </div>
</BaseLayout>
