---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import ImagePlaceholder from "../components/ui/ImagePlaceholder.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import { site } from "../data/site";

// The tagline doubles as how we work. Titles stay in English, as the tagline does.
const values = [
  { title: "Consult.", text: "Ascultăm înainte să recomandăm. Vedem locația și aflăm cum folosiți spațiul." },
  { title: "Design.", text: "Alcătuim un sistem pe măsură, cu echipamente alese pentru condițiile reale, nu din catalog." },
  { title: "Secure.", text: "Instalăm, testăm și rămânem alături de dumneavoastră prin service și mentenanță." },
];

// TODO(content): confirm each claim with the company before launch
const reasons = [
  { title: "Firmă licențiată", text: `Lucrăm conform legislației privind securitatea fizică, cu licență IGPR ${site.legal.igprLicense}.` },
  { title: "Echipă proprie", text: "Aceiași oameni recomandă, instalează și întrețin sistemul. Știți mereu cu cine vorbiți." },
  { title: "Echipamente verificate", text: "Folosim echipamente de la producători consacrați, cu garanție și piese disponibile." },
  { title: "Mentenanță", text: "Verificări periodice și intervenții rapide, pentru sisteme care funcționează atunci când contează." },
];
---
<BaseLayout title="Despre noi"
  description="Onyx Security Solutions recomandă, instalează și întreține sisteme de securitate. Aflați cine suntem și cum lucrăm.">
  <Section>
    <div class="grid items-center gap-12 md:grid-cols-2">
      <SectionHeading as="h1" size="display" eyebrow="Despre noi"
        lead="Suntem o echipă de specialiști în sisteme de securitate. Recomandăm, instalăm și întreținem soluții pentru locuințe, companii și instituții.">
        Securitate gândită de la început.
      </SectionHeading>
      <ImagePlaceholder chamfer="lg" />
    </div>
  </Section>

  <Section class="pt-0 md:pt-0">
    <div class="grid gap-12 md:grid-cols-[1fr_2fr]">
      <SectionHeading eyebrow="Cine suntem">Oamenii din spatele sistemelor.</SectionHeading>
      {/* TODO(content): company story, founding year, team size */}
      <div class="flex max-w-[65ch] flex-col gap-4 text-ink-muted">
        <p class="m-0">
          [Povestea firmei: când a fost înființată, cine o conduce și ce a determinat-o să se specializeze în sisteme de securitate.]
        </p>
        <p class="m-0">
          Credem că un sistem de securitate bun nu se vede până nu ai nevoie de el. De aceea începem fiecare lucrare cu o discuție
          atentă și terminăm abia după ce sistemul funcționează exact cum v-ați propus.
        </p>
      </div>
    </div>
  </Section>

  <Section>
    <SectionHeading eyebrow="Cum lucrăm">{site.tagline}</SectionHeading>
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
      {values.map((v) => (
        <div class="flex flex-col gap-3 border border-line bg-surface p-6">
          <h3 class="m-0 text-title uppercase">{v.title}</h3>
          <span class="rule-gold" aria-hidden="true" />
          <p class="m-0 text-small text-ink-muted">{v.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section>
    <SectionHeading eyebrow="De ce Onyx">Un singur partener, de la prima discuție la service.</SectionHeading>
    <ul class="m-0 mt-8 grid list-none grid-cols-1 gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
      {reasons.map((r) => (
        <li class="flex flex-col gap-3 border-t border-line pt-6">
          <h3 class="m-0 text-title uppercase">{r.title}</h3>
          <p class="m-0 text-small text-ink-muted">{r.text}</p>
        </li>
      ))}
    </ul>
    <p class="m-0 mt-12 max-w-[65ch] text-body-lg text-ink">
      Zona deservită: {site.contact.serviceArea}.
    </p>
  </Section>

  <CtaBand />
</BaseLayout>
